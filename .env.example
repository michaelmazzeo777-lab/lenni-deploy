# Field Guide Studio — safe placeholders only. NEVER commit real values.

# Local PostgreSQL connection (names/placeholders only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldguide"
# Separate database used by the integration test suite.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldguide_test"

# Signing secret for local session cookies. Replace locally; do not commit a real secret.
AUTH_SECRET="replace-with-a-long-random-string-locally"

APP_BASE_URL="http://localhost:3000"

# AI provider selection: "mock" (default, deterministic) or "anthropic" (server-only).
AI_PROVIDER="mock"
# Server-only. Leave blank to use the deterministic mock provider.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Deny-by-default kill switch for the AI subsystem.
AI_ENABLED="true"

# Public site: set to "false" on draft/staging to disallow indexing.
PUBLIC_SITE_INDEXABLE="false"

# Object storage (later phase). Local metadata-only placeholder is used for MVP.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
