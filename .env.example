# Field Guide Studio — safe placeholders only. NEVER commit real values.

# Local PostgreSQL connection (names/placeholders only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldguide"
# Separate database used by the integration test suite.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldguide_test"

# Signing secret for local session cookies. Replace locally; do not commit a real secret.
AUTH_SECRET="replace-with-a-long-random-string-locally"

APP_BASE_URL="http://localhost:3000"

# AI provider selection: "mock" (default, deterministic) or "anthropic" (server-only).
AI_PROVIDER="mock"
# Server-only. Leave blank to use the deterministic mock provider.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Deny-by-default kill switch for the AI subsystem.
AI_ENABLED="true"

# Public site: set to "false" on draft/staging to disallow indexing.
PUBLIC_SITE_INDEXABLE="false"

# Local quarantine-first file storage root (gitignored). An S3-compatible
# adapter is a later phase; this local adapter is real (not a placeholder).
STORAGE_ROOT="./.data/storage"

# Object storage (later phase, disabled). Local adapter above is used for MVP.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ---- YouTube Shorts pipeline (docs/YOUTUBE_SHORTS_PIPELINE_BLUEPRINT.md) ----
# Every provider defaults to "mock" (deterministic, $0, no external calls).
# Local pipeline (real MP4s on this machine, $0, no network, needs ffmpeg with
# libass - `brew install ffmpeg-full`):
#   SHORTS_SCRIPT_PROVIDER="local-operator"      operator-written script
#   TTS_PROVIDER="local-say-fixture"             macOS system voice, FIXTURE ONLY
#   TTS_PROVIDER="operator-recording"            real narration file from the ingest folder
#   VIDEO_COMPOSITOR_PROVIDER="local-ffmpeg"     real 9:16 / 16:9 H.264 render
# Hosted providers require Mike to create the accounts and supply keys locally.
# Local speech-to-text for narration and render QA (whisper.cpp `whisper-cli`).
# Path to a ggml model file, e.g. ggml-base.en.bin. Not part of the repository.
# Unset or missing: transcription checks report NOT_VERIFIED (never a pass) and
# the draft is flagged HUMAN LISTENING VALIDATION REQUIRED.
WHISPER_MODEL_PATH=""
# WHISPER_CLI_PATH="/opt/homebrew/bin/whisper-cli"
# Optional stricter editorial limit for 9:16 renders, in seconds (e.g. "58").
# Unset: the YouTube Shorts platform limit of 180s applies. Never raises it.
SHORTS_EDITORIAL_MAX_SEC=""
SHORTS_SCRIPT_PROVIDER="mock"
SHORTS_SCRIPT_API_KEY=""
TTS_PROVIDER="mock"
TTS_API_KEY=""
VIDEO_COMPOSITOR_PROVIDER="mock"
VIDEO_COMPOSITOR_API_KEY=""
YOUTUBE_PUBLISHER="mock"
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
YOUTUBE_CHANNEL_ID=""

# Folder the Studio reads operator-supplied media from (PS5 USB exports,
# narration recordings). Files are referenced by bare name only.
CAPTURE_INGEST_DIR="./.data/ingest"
# Optional overrides; default prefers Homebrew ffmpeg-full, then PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
