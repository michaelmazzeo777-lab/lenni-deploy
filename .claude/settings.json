{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run db:*)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run build)",
      "Bash(pnpm run db:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(vercel deploy *)",
      "Bash(npx prisma migrate deploy *)"
    ]
  }
}
